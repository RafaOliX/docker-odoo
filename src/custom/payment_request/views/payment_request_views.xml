<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_request_tree" model="ir.ui.view">
        <field name="name">payment.request.tree</field>
        <field name="model">payment.request</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-info="state == 'paid'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="requester_id"/>
                <field name="date"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_payment_request_form" model="ir.ui.view">
        <field name="name">payment.request.form</field>
        <field name="model">payment.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de Pago">
                <header>
                    <button name="action_submit" string="Enviar" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    
                    <button name="action_approve" string="Aprobar" type="object" class="oe_highlight" 
                            invisible="state != 'submitted'" 
                            groups="payment_request.group_payment_request_approver"/>
                    
                    <button name="%(action_payment_request_reject)d" string="Rechazar" type="action" 
                            invisible="state != 'submitted'" 
                            groups="payment_request.group_payment_request_approver" 
                            context="{'default_request_id': id}"/>
                    
                    <button name="%(action_payment_request_pay)d" string="Pagar" type="action" class="oe_highlight" 
                            invisible="state != 'approved'" 
                            groups="payment_request.group_payment_request_treasury" 
                            context="{'default_request_id': id}"/>
                    
                    <button name="action_reset_draft" string="Volver a Borrador" type="object" invisible="state not in ('rejected', 'submitted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="requester_id"/>
                            <field name="approver_id"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="converted_currency_id" invisible="1"/>
                            <field name="amount_company_currency" readonly="1" force_save="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Concepto">
                            <field name="concept" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_payment_request_search" model="ir.ui.view">
        <field name="name">payment.request.search</field>
        <field name="model">payment.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="requester_id"/>
                <filter name="my_requests" string="Mis Solicitudes" domain="[('requester_id', '=', uid)]"/>
                <separator/>
                <filter name="draft" string="Borradores" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Enviadas" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Aprobadas" domain="[('state', '=', 'approved')]"/>
                <filter name="paid" string="Pagadas" domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_by_partner" string="Proveedor" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_payment_approval_level_tree" model="ir.ui.view">
        <field name="name">payment.approval.level.tree</field>
        <field name="model">payment.approval.level</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="min_amount"/>
                <field name="currency_id" invisible="1"/>
                <field name="approver_id"/>
            </tree>
        </field>
    </record>

    <record id="action_payment_request" model="ir.actions.act_window">
        <field name="name">Solicitudes</field>
        <field name="res_model">payment.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_my_requests': 1}</field>
    </record>

    <record id="action_payment_approval_level" model="ir.actions.act_window">
        <field name="name">Niveles de Aprobación</field>
        <field name="res_model">payment.approval.level</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
