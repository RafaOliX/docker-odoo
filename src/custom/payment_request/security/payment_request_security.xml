<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_payment_request_user" model="res.groups">
        <field name="name">Solicitante</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_payment_request_approver" model="res.groups">
        <field name="name">Aprobador</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_request_user'))]"/>
    </record>
    <record id="group_payment_request_treasury" model="res.groups">
        <field name="name">Tesorería</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_request_approver'))]"/>
    </record>
    <record id="rule_payment_request_own" model="ir.rule">
        <field name="name">Solicitudes: el solicitante ve las suyas</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[('requester_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_user'))]"/>
    </record>
    <record id="rule_payment_request_all" model="ir.rule">
        <field name="name">Solicitudes: aprobadores y tesorería ven todas</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_approver')), (4, ref('group_payment_request_treasury'))]"/>
    </record>
</odoo>
