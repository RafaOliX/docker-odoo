<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Rechazo -->
    <record id="view_payment_request_reject_form" model="ir.ui.view">
        <field name="name">payment.request.reject.form</field>
        <field name="model">payment.request.reject</field>
        <field name="arch" type="xml">
            <form string="Rechazar Solicitud">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="reason" placeholder="Explique detalladamente el motivo del rechazo..."/>
                </group>
                <footer>
                    <button name="action_reject" string="Confirmar Rechazo" type="object" class="btn-danger"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Vista de Pago -->
    <record id="view_payment_request_pay_form" model="ir.ui.view">
        <field name="name">payment.request.pay.form</field>
        <field name="model">payment.request.pay</field>
        <field name="arch" type="xml">
            <form string="Registrar Pago">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="amount" readonly="1"/>
                    <field name="journal_id"/>
                </group>
                <footer>
                    <button name="action_pay" string="Registrar Pago Contable" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acciones para abrir los Wizards -->
    <record id="action_payment_request_reject" model="ir.actions.act_window">
        <field name="name">Rechazar Solicitud</field>
        <field name="res_model">payment.request.reject</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_payment_request_pay" model="ir.actions.act_window">
        <field name="name">Registrar Pago</field>
        <field name="res_model">payment.request.pay</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
